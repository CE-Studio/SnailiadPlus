~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS2)
	NPC40: Be careful, {{Player.player_name}}!![wait=0.25]  I've heard\nsome[speed=0.4] {{GlobalText.EFF_SHAKE}}scary stuff[speed=1][/wave] happening in\nthe next room!!
else
	NPC40: Wow!![wait=0.2]  You defeated the evil\nmonster??[wait=0.2]  {{GlobalText.EFF_WAVE}}You're my hero,\n{{Player.player_full_name}}!!
=> END