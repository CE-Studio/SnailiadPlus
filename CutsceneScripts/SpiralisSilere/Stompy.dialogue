~ start
do CutsceneController.lock_input()
if CutsceneController.player_right_of(408)
	do CutsceneController.trigger_animation("IntroDefaultFromRight", true)
else
	do CutsceneController.trigger_animation("IntroDefaultFromLeft", true)
do wait(2.7)
do CutsceneController.set_camera_focus_player()
=> END