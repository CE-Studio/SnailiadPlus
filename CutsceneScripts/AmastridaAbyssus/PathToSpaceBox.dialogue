~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.check_item(Item.ItemTypes.RAPID_FIRE)
	NPC42: Hey, {{Player.player_name}}![wait=0.15]  I heard a rumor that the next room is too hard without "[color=#ffb23d]Rapid Fire[/color]"!!
elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS3)
	# WaveHere
	NPC42: {{GlobalText.COL_MOON}}Moon Snail[/color] brought me here!\n[wait=0.15]Isn't he nice?[wait=0.15]  All the [color=#ff75f6]pink grass[/color] I could ever eat!!
else
	NPC42: What?[wait=0.15]  There was a [color=#ff4f99]monster[/color] in the next room??[wait=0.25]  Are you trying to scare me, {{Player.player_name}}??
=> END