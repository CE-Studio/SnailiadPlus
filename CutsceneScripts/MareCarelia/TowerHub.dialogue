~ start
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
match CutsceneController.object_id
	when "48"
		do CutsceneController.lock_input()
		if CutsceneController.instance.actor_above("48", 360)
			NPC48: Hey, {{Player.player_name}}, what's up?
		else
			NPC48: {{GlobalText.EFF_WAVE}}Whew!![wait=0.25][/wave]  That was scary!!
	when "48Fall"
		do CutsceneController.set_sound("2")
		do CutsceneController.set_next_timeout(0.0)
		NPC48: {{GlobalText.EFF_SHAKE}}[speed=1.25]YEEEEEEEEEEEEEEEEEEEEEEEEEE\nEEEEEEEEEEEEEEEEEEEEEEEEEEE\nEEEEEEEEEEEEEEEEEEEEEEEEEEE
=> END