~ start
match CutsceneController.object_id
	when "Set26Shell"
		if not Statics.is_random_game
			if Player.instance.who_i_is == Player.Players.SLUGGY or Player.instance.who_i_is == Player.Players.LEECHY
				do CutsceneController.set_actor("26")
				do CutsceneController.perform_action("face_right", false)
				do CutsceneController.perform_action("toggle_shell", false)
				do CutsceneController.perform_action("set_wont_talk", false)
	when "26"
		do CutsceneController.lock_input()
		do CutsceneController.show_textbox()
		do CutsceneController.set_textbox_color("#004457")
		do CutsceneController.set_textbox_frame(0)
		if not Statics.is_random_game
			if Player.instance.who_i_is != Player.Players.BLOBBY
				NPC26: With this "Shell Shield",[wait=0.1] you won't take any damage when you hide in your shell!
			else
				NPC26: Take this "Shelmet"![wait=0.25]  You can hide in it to avoid taking damage!
		else
			NPC26: Here, take this[speed=0.25]...[speed=1][wait=0.2] thing![wait=0.3]  I'm not sure what it is,[wait=0.25] but surely it's helpful![wait=0.5]  Right?
=> END