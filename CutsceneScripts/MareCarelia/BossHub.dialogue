~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS1)
	NPC41: Watch out, {{Player.player_name}}!![wait=0.25]\nA [color=#ff4f99]fierce monster[/color] is hiding\nin the next room!!
	NPC41: Come to think of it, though...[wait=0.3] I\nwonder if that [color=#babfc2]grey door[/color] down\nthere will open if you beat it?
elif not Statics.check_item(Item.ItemTypes.BOOMERANG)
	NPC41: Oh hey,[wait=0.15] that [color=#babfc2]grey door[/color] below\nand to the left opened up![wait=0.3]\nI wonder what's inside?
elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS4)
	if Player.instance.who_i_is == Player.Players.SNAILY
		NPC41: Good luck, {{Player.player_name}}![wait=0.15]  I'll wait\nhere for you!![wait=0.25]  Let's have lots\nof baby snails later, okay?
	else
		NPC41: Good luck, {{Player.player_name}}!
else
	NPC41: {{Player.player_full_name}}, you came\nback!![wait=0.15]  {{GlobalText.EFF_WAVE}}Yay!!
=> END