~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.check_item(Item.ItemTypes.PEASHOOTER)
	NPC7: Are you leaving town, {{Player.player_name}}?[wait=0.25]\nWell,[wait=0.125] be careful![wait=0.25]  Make sure\nyou [color=#42f9a2]save your game often[/color]!!
elif not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
	NPC7: Hey, {{Player.player_name}}![wait=0.25]  Where'd you get\nthe pea shooter?
elif not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE) and not Statics.check_item(Item.ItemTypes.DEBUG_WAVE)
	NPC7: Ooh,[wait=0.125] boomerangs![wait=0.25]  If I had\nthose,[wait=0.125] I'd try breaking the\nceiling over the save spot!
elif not Statics.check_item(Item.ItemTypes.DEVASTATOR)
	NPC7: Rainbows are so pretty![wait=0.25]\nDon't you think so, {{Player.player_name}}?
elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS4)
	NPC7: I'm scared, {{Player.player_name}}![wait=0.25]\nIs {{GlobalText.COL_MOON}}Moon Snail[/color] going to take\nme away like the others?
else
	NPC7: {{GlobalText.COL_TOWN}}Snail Town[/color] is safe again,[wait=0.125]\nthanks to you,[wait=0.125] {{Player.player_name}}!
=> END