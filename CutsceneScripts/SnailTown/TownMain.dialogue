~ start
do CutsceneController.lock_input()
if CutsceneController.object_id == "17"
	do CutsceneController.set_textbox_player_preset(Player.Players.UPSIDE)
else
	do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
match CutsceneController.object_id
	when "0"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER)
			match Player.instance.who_i_is
				when Player.Players.LEGGY
					NPC0: Leggy placeholder
				when Player.Players.BLOBBY
					NPC0: Blobby placeholder
				else
					NPC0: Hi, {{Player.player_name}}!![wait=0.25]  Why don't you try\nclimbing up the walls?\n[wait=0.25]     Just {{GlobalText.COL_CTRL}}hold "{{SInput.icon_up}}" and "{{SInput.icon_right}}"[/color].
		elif not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			NPC0: Oh, [wait=0.125]nice pea shooter!  [wait=0.125]I heard\nyou can shoot a [color=#007df4]blue door[/color]\nopen with one of those!
		elif not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE) and not Statics.check_item(Item.ItemTypes.DEBUG_WAVE)
			NPC0: Wow, a boomerang!  [wait=0.125]You could\nbreak a [color=#ff75f6]pink door[/color] open with\njust one of those!
		elif not Statics.check_item(Item.ItemTypes.DEVASTATOR)
			NPC0: Is that a rainbow wave!?[wait=0.25]  Well,\nthen![wait=0.25]  You can open a [color=#ff2024]red door[/color]\nwith one of those!
		elif Statics.get_item_percentage() < 100.0
			NPC0: A {{GlobalText.EFF_SHAKE}}devastator!?[/shake][wait=0.4]  That opens up\n[color=#4bd867]green doors![/color][wait=0.25]  It also upgrades\nall of your weapons![wait=0.25]  {{GlobalText.EFF_WAVE}}Wow!!
		else
			NPC0: I hope the next game has more\nweapons.[wait=0.25]  This game could have\nused a {{GlobalText.EFF_WAVE}}flame whip!
	
	when "1"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE)
			NPC1: {{Player.player_name}},[wait=0.125] some snails are missing![wait=0.25]\nDo you think you could go look\nfor them?[wait=0.25]  I'm getting worried!
		elif Statics.get_item_percentage() < 100.0
			NPC1: I have a goal in life.[wait=0.25]  One day,\nI will eat a pizza.[wait=0.4]  I mean it!![wait=0.4][speed=0.4]\nJust you watch, [wait=0.0625]{{Player.player_name}}!!
		else
			NPC1: {{Player.player_name}},[wait=0.125] you missed it![wait=0.25]  I made a\ndelicious pizza,[wait=0.125] and I ate the\nwhole[wait=0.125] thing!!![wait=0.3][speed=0.5]  {{GlobalText.EFF_WAVE}}Om nom nom!
	
	when "2"
		if not Statics.is_random_game
			if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you finding a weapon\nsomewhere under the water!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS1) and not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS2)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading to the upper\nright part of the map!!
			elif not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\nI see you forgot to grab the\nboomerang after Shellbreaker!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS2)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading to the lower\nright part of the map!!
			elif not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\nI see you forgot to grab the\nrainbow wave after Stompy!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS3)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading to the lower\nleft part of the map!!
			elif not Statics.check_item(Item.ItemTypes.RAPID_FIRE)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\nI see you forgot to grab the\nrapid fire before Space Box!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS4)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading to the upper\nleft part of the map!!
			elif Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 30
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading all over the\nmap, finding little shells!
			elif not Statics.get_world_flag(Statics.WorldFlags.TALKED_TO_IRIS)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you heading precisely two\nscreens to the left of here!!
			else
				# WaveHere
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\nI see you having 18,000,000\nbaby {{Player.player_species_plural}}!![wait=0.25]  Congratulations!!
		else
			NPC2: Yeah,[wait=0.25] I have no idea what's going\non here.[wait=0.3]  You're on your own,\n{{Player.player_name}}!
	
	when "3"
		if not Statics.check_item(Item.ItemTypes.GRAVITY_SHELL)
			NPC3: I wonder why I can't crawl on\nceiling corners...[wait=0.25]  Do you think\nI'll ever be able to, {{Player.player_name}}?
			if Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: \nOf course,[wait=0.125] you don't have to worry about them at all, do you?[wait=0.25]  I wish I could flip!
		elif not Statics.check_item(Item.ItemTypes.METAL_SHELL)
			if Player.instance.who_i_is == Player.Players.UPSIDE
				NPC3: \nOh, my,[wait=0.125] you're a [color=#ff705f]magnet snail[/color]![wait=0.25]  You must be really good at crawling around ceilings!!
			elif Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: \nWhat's it like to flip, {{Player.player_name}}?[wait=0.25]  I wish I was a gravity snail!!
			elif Player.instance.who_i_is == Player.Players.BLOBBY
				NPC3: \nOh, my,[wait=0.125] you're an [color=#dcb7f8]angelblob[/color]![wait=0.25]  I bet you could scale a whole room in one big jump!!
			else
				NPC3: Oh, my,[wait=0.125] you're a [color=#42f9a2]gravity {{Player.player_species}}[/color]![wait=0.25]\nYou must be really good at\ncrawling around ceilings!!
		else
			if Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: \nWhat's it like to flip, {{Player.player_name}}?[wait=0.25]  I wish I was a gravity snail!!
			elif Player.instance.who_i_is == Player.Players.BLOBBY
				NPC3: \nOh, my,[wait=0.125] you're a [color=#ff2024]devilblob[/color]![wait=0.25]  I bet you could scale a whole room in one big jump!!
			elif Player.instance.who_i_is == Player.Players.SLUGGY or Player.instance.who_i_is == Player.Players.LEECHY
				NPC3: Oh, my,[wait=0.125] you're a [color=#ffb6f8]full power\n{{Player.player_species}}[/color]![wait=0.25]  You must be really good\nat crawling around ceilings!!
			else
				NPC3: Oh, my,[wait=0.125] you're a [color=#ffb6f8]full metal\n{{Player.player_species}}[/color]![wait=0.25]  You must be really good\nat crawling around ceilings!!
	
	when "4"
		if Statics.solid_at_world_pos(Vector2(552, 232))
			NPC4: I wish I had some way to break\ngreen blocks.[wait=0.125]  Those suckers\nare always getting in my way!!
		else
			NPC4: {{GlobalText.EFF_WAVE}}Whew![wait=0.25][/wave]  Thanks, {{Player.player_name}}![wait=0.125]  I think\nthose blocks were planning to\nattack!![wait=0.125]  You saved the day!!
	
	when "5"
		if Statics.get_item_percentage() < 100.0
			NPC5: There's a lot of secrets\nin and around {{GlobalText.COL_TOWN}}Snail Town[/color].[wait=0.25]\nHave you found them all?
		else
			NPC5: They say [color=#f6cdb5]Boss Rush[/color] is the\ntrue test of snail skill.[wait=0.3][speed=0.75]\nBut what about slug skill?
	
	when "6"
		if Statics.check_item(Item.ItemTypes.HIGH_JUMP) or Statics.check_item(Item.ItemTypes.GRAVITY_SHELL) or Player.instance.who_i_is == Player.Players.UPSIDE or Player.instance.who_i_is == Player.Players.LEGGY
			NPC6: Don't you think it's weird that\nwe all live in treehouses?
		else
			NPC6: Hey {{Player.player_name}},[wait=0.125] how'd you get up\nhere?[wait=0.4]  And how do I get down?
	
	when "14"
		if Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 15
			NPC14: Hey, {{Player.player_name}}![wait=0.25]  Keep an eye out\nfor {{GlobalText.COL_IRIS}}"Helix Fragments"[/color].[wait=0.25]  They\nlook like spinning white shells!
		elif Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 30 or not Statics.get_world_flag(Statics.WorldFlags.TALKED_TO_IRIS)
			NPC14: They say that the {{GlobalText.COL_IRIS}}Shrine of\nIris[/color] is not located on any map!
		else
			NPC14: Wow, {{Player.player_name}}![wait=0.125]  You're pretty good\nat finding secrets![wait=0.25]  Maybe you\nshould become a detective!
	
	when "15"
		if Statics.get_item_percentage() < 20.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a\nhint:[wait=0.125] Come back to town after\neach area to find secret items!
		elif Statics.get_item_percentage() < 40.0
			if Player.instance.who_i_is == Player.Players.SNAILY or Player.instance.who_i_is == Player.Players.UPSIDE
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a\nlittle hint:[wait=0.125] A shell can fit\nwhere a snail cannot!
			elif Player.instance.who_i_is == Player.Players.SLUGGY or Player.instance.who_i_is == Player.Players.LEECHY
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Here's a li'l hint:[wait=0.125]\n{{Player.player_species_plural}} may be more fragile than\nsnails,[wait=0.125] but they're also faster!
			elif Player.instance.who_i_is == Player.Players.LEGGY
				NPC15: \nHi, {{Player.player_name}}![wait=0.125]  Here's a tip:[wait=0.125] It may look too big,[wait=0.125] but your shell can fit in places that ours can!
			else
				NPC15: \nHi, {{Player.player_name}}![wait=0.125]  Here's a little tip:[wait=0.125] You don't have to be on the ground to jump!
		elif Statics.get_item_percentage() < 60.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a\nhint:[wait=0.125] Sometimes, you'll miss a\nsecret if you cling to a wall!
		elif Statics.get_item_percentage() < 80.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a\nhint:[wait=0.125] You can find the "high\njump" before any other item!
		elif Statics.get_item_percentage() < 100.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me tell you a\nsecret:[wait=0.125] There's a boomerang\nsomewhere in {{GlobalText.COL_TOWN}}Snail Town[/color]!
		else
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me tell you a\nsecret:[wait=0.125] there's a secret\nsomewhere in the main menu!
	
	when "16"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			if Player.instance.who_i_is != Player.Players.LEECHY
				NPC16: If you ever get hurt,[wait=0.125] [color=#4bd867]eat some\nplants[/color]![wait=0.25]  You need to eat well\nto stay fit and healthy!
			else
				NPC16: \nIf you ever get hurt,[wait=0.125] defeat enemies![wait=0.25]  As a leech,[wait=0.125] you can earn [color=#ff75f6]pink heath orbs[/color] off them!
		elif CutsceneController.instance.actor_above("16", 710)
			NPC16: I want to go for a ride!!!
		else
			NPC16: {{GlobalText.EFF_WAVE}}[speed=0.6]WHEEEE!![speed=1][wait=0.125][/wave]  That was fun,\n{{Player.player_name}}![wait=0.125]  Let's do it again!!
	
	when "17"
		if Statics.get_item_percentage() < 100.0
			NPC17: There's a hidden room under the\npath into town.[wait=0.25]  I don't know\nhow to get in yet, though...
		else
			NPC17: They call me [color=#fcd884]upside-down snail[/color],[wait=0.25]\nbut I think everyone else is\nupside down!
	
	when "25"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			NPC25: Have you tried hitting {{GlobalText.COL_CTRL}}"{{SInput.icon_map}}"[/color]\nyet?[wait=0.25]  It makes the map big![wait=0.25]  Oh,[wait=0.125]\nand hit {{GlobalText.COL_CTRL}}"{{SInput.icon_pause}}"[/color] for the menu!
		else
			NPC25: Hey {{Player.player_name}},[wait=0.125] I'm hungry![wait=0.25]  Know\nany good plants around town?
	
do CutsceneController.hide_textbox()
=> END