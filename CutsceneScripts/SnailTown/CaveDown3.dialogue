~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.is_random_game
	if not Statics.check_location_collected(10)
		NPC24: Take this {{GlobalText.COL_IRIS}}Helix Fragment[/color]![wait=0.25] Legend says it is but one piece of {{GlobalText.COL_IRIS}}Iris, the Godsnail[/color]!
	else
		NPC24: {{Player.player_name}},[wait=0.125] legend says the {{GlobalText.COL_IRIS}}Shrine of Iris[/color] is somewhere very close to Snail Town!!
else
	NPC24: I heard that some doors in the world can only be opened with small amounts of {{GlobalText.COL_IRIS}}Iris[/color]' power!
=> END