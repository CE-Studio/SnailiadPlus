~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
if not Statics.check_location_collected(6) and not Statics.is_random_game
	NPC12: Heya, {{Player.player_name}}![wait=0.125]  I filled the heart container over there with some fresh slime![wait=0.25]  Enjoy!!
else
	# WaveHere
	NPC12: Isn't breaking blocks fun!?
=> END