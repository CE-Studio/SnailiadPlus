do CutsceneController.show_textbox()
if Statics.solid_at_world_pos(Vector2(248, 136))
	NPC8: There's something funny about that tree...
else
	# ShakeHere
	NPC8: I[wait=0.125] knew[wait=0.125] there was something weird about that tree!!
=> END