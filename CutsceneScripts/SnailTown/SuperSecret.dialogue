~ start
do CutsceneController.lock_input()
do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
match CutsceneController.object_id
	when "9"
		if Statics.get_item_percentage() < 100.0
			NPC9: The other snails live in houses,[wait=0.125] but I like it here in the dirt.[wait=0.25]  Isn't it nice in here?
		else
			# WaveHere
			NPC9: It's so cozy in here![wait=0.25]  I just [speed=0.6]love[speed=1] my little underground\nhome!
	
	when "18"
		if not Statics.is_random_game
			if not Statics.check_location_collected(3)
				# WaveHere
				NPC18: You found the super secret boomerang![wait=0.125]  Way to go![wait=0.25]  Press {{GlobalText.COL_CTRL}}"{{SInput.icon_shoot}}"[/color] to shoot with it!
			else
				NPC18: Don't forget![wait=0.25]\nPress {{GlobalText.COL_CTRL}}"{{SInput.icon_shoot}}"[/color] to shoot your weapon at stuff!!
		else
			# ShakeHere
			NPC18: EEEK!![wait=0.5]  You found me!
=> END