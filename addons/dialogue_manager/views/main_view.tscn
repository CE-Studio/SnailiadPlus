[node name="CodeEdit" parent="Margin/Content/CodePanel" unique_id=2083768913 instance=ExtResource("2_f73fm")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.8025, 0.81, 0.8225, 1)
theme_override_colors/background_color = Color(0.115499996, 0.132, 0.15949999, 1)
theme_override_colors/current_line_color = Color(1, 1, 1, 0.07)
theme_override_fonts/font = ExtResource("7_y6rqu")
theme_override_font_sizes/font_size = 14
theme_override_colors/bookmark_color = Color(1, 0.333333, 0.333333, 1)
text = "~ start
do CutsceneController.lock_input()
if CutsceneController.object_id == \"17\"
	do CutsceneController.set_textbox_player_preset(Player.Players.UPSIDE)
else
	do CutsceneController.reset_textbox_color()
do CutsceneController.set_textbox_frame(0)
do CutsceneController.show_textbox()
match CutsceneController.object_id
	when \"0\"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER)
			match Player.instance.who_i_is
				when Player.Players.LEGGY
					NPC0: Leggy placeholder
				when Player.Players.BLOBBY
					NPC0: Blobby placeholder
				else
					NPC0: Hi, {{Player.player_name}}!![wait=0.25]  Why don't you try climbing up the walls?\\n[wait=0.25]     Just {{GlobalText.COL_CTRL}}hold \"{{SInput.icon_up}}\" and \"{{SInput.icon_right}}\"[/color].
		elif not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			NPC0: Oh, [wait=0.125]nice pea shooter!  [wait=0.125]I heard you can shoot a [color=#007df4]blue door[/color] open with one of those!
		elif not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE) and not Statics.check_item(Item.ItemTypes.DEBUG_WAVE)
			NPC0: Wow, a boomerang!  [wait=0.125]You could break a [color=#ff75f6]pink door[/color] open with just one of those!
		elif not Statics.check_item(Item.ItemTypes.DEVASTATOR)
			NPC0: Is that a rainbow wave!?[wait=0.25]  Well, then![wait=0.25]  You can open a [color=#ff2024]red door[/color] with one of those!
		elif Statics.get_item_percentage() < 100.0
			# ShakeHere SfxHere
			NPC0: A devastator!?[wait=0.4]  That opens up [color=#4bd867]green doors![/color][wait=0.25]  It also upgrades all three weapons!  Wow!!
		else
			# WaveHere
			NPC0: I hope the next game has more weapons.[wait=0.25]  This game could have used a flame whip!
	
	when \"1\"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE)
			NPC1: {{Player.player_name}},[wait=0.125] some snails are missing![wait=0.25] Do you think you could go look for them?[wait=0.25]  I'm getting worried!
		elif Statics.get_item_percentage() < 100.0
			NPC1: I have a goal in life.[wait=0.25]  One day, I will eat a pizza.[wait=0.4]  I mean it!![wait=0.4][speed=0.4]  Just you watch, [wait=0.0625]{{Player.player_name}}!!
		else
			# SfxHere WaveHere
			NPC1: {{Player.player_name}},[wait=0.125] you missed it![wait=0.25]  I made a delicious pizza,[wait=0.125] and I ate the whole[wait=0.125] thing!!![wait=0.3][speed=0.5]  Om nom nom!
	
	when \"2\"
		if not Statics.is_random_game
			if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you finding a weapon somewhere under the water!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS1) and not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS2)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading to the upper right part of the map!!
			elif not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\\nI see you forgot to grab the boomerang after Shellbreaker!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS2)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading to the lower right part of the map!!
			elif not Statics.check_item(Item.ItemTypes.RAINBOW_WAVE)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\\nI see you forgot to grab the rainbow wave after Stompy!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS3)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading to the lower left part of the map!!
			elif not Statics.check_item(Item.ItemTypes.RAPID_FIRE)
				NPC2: [color=#b9b8f7]I can see the past, {{Player.player_name}}![/color][wait=0.3]\\nI see you forgot to grab the rapid fire before Space Box!
			elif not Statics.get_world_flag(Statics.WorldFlags.DEFEATED_BOSS4)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading to the upper left part of the map!!
			elif Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 30
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading all over the map, finding little shells!
			elif not Statics.get_world_flag(Statics.WorldFlags.TALKED_TO_IRIS)
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you heading precisely two screens to the left of here!!
			else
				# WaveHere
				NPC2: [color=#b9b8f7]I can see the future, {{Player.player_name}}![/color][wait=0.3]\\nI see you having 18,000,000 baby {{Player.player_species_plural}}!![wait=0.25]  Congratulations!!
		else
			NPC2: Yeah,[wait=0.25] I have no idea what's going on here.[wait=0.3]  You're on your own, {{Player.player_name}}!
	
	when \"3\"
		if not Statics.check_item(Item.ItemTypes.GRAVITY_SHELL)
			NPC3: I wonder why I can't crawl on ceiling corners...[wait=0.25]  Do you think I'll ever be able to, {{Player.player_name}}?
			if Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: Of course,[wait=0.125] you don't have to worry about them at all, do you?[wait=0.25]  I wish I could flip!
		elif not Statics.check_item(Item.ItemTypes.METAL_SHELL)
			if Player.instance.who_i_is == Player.Players.UPSIDE
				NPC3: Oh, my,[wait=0.125] you're a [color=#ff705f]magnet snail[/color]![wait=0.25]  You must be really good at crawling around ceilings!!
			elif Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: What's it like to flip, {{Player.player_name}}?[wait=0.25]  I wish I was a gravity snail!!
			elif Player.instance.who_i_is == Player.Players.BLOBBY
				NPC3: Oh, my,[wait=0.125] you're an [color=#dcb7f8]angelblob[/color]![wait=0.25]  I bet you could scale a whole room in one big jump!!
			else
				NPC3: Oh, my,[wait=0.125] you're a [color=#42f9a2]gravity {{Player.player_species}}[/color]![wait=0.25]  You must be really good at crawling around ceilings!!
		else
			if Player.instance.who_i_is == Player.Players.LEGGY
				NPC3: What's it like to flip, {{Player.player_name}}?[wait=0.25]  I wish I was a gravity snail!!
			elif Player.instance.who_i_is == Player.Players.BLOBBY
				NPC3: Oh, my,[wait=0.125] you're a [color=#ff2024]devilblob[/color]![wait=0.25]  I bet you could scale a whole room in one big jump!!
			elif Player.instance.who_i_is == Player.Players.SLUGGY or Player.instance.who_i_is == Player.Players.LEECHY
				NPC3: Oh, my,[wait=0.125] you're a [color=#ffb6f8]full power {{Player.player_species}}[/color]![wait=0.25]  You must be really good at crawling around ceilings!!
			else
				NPC3: Oh, my,[wait=0.125] you're a [color=#ffb6f8]full metal {{Player.player_species}}[/color]![wait=0.25]  You must be really good at crawling around ceilings!!
	
	when \"4\"
		if Statics.solid_at_world_pos(Vector2(552, 232))
			NPC4: I wish I had some way to break green blocks.[wait=0.125]  Those suckers are always getting in my way!!
		else
			# WaveHere
			NPC4: Whew![wait=0.25]  Thanks, {{Player.player_name}}![wait=0.125]  I think those blocks were planning to attack!![wait=0.125]  You saved the day!!
	
	when \"5\"
		if Statics.get_item_percentage() < 100.0
			NPC5: There's a lot of secrets in and around {{GlobalText.COL_TOWN}}Snail Town[/color].[wait=0.25]  Have you found them all?
		else
			NPC5: They say [color=#f6cdb5]Boss Rush[/color] is the true test of snail skill.[wait=0.3][speed=0.75]  But what about slug skill?
	
	when \"6\"
		if Statics.check_item(Item.ItemTypes.HIGH_JUMP) or Statics.check_item(Item.ItemTypes.GRAVITY_SHELL) or Player.instance.who_i_is == Player.Players.UPSIDE or Player.instance.who_i_is == Player.Players.LEGGY
			NPC6: Don't you think it's weird that we all live in treehouses?
		else
			NPC6: Hey {{Player.player_name}},[wait=0.125] how'd you get up here?[wait=0.4]  And how do I get down?
	
	when \"14\"
		if Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 15
			NPC14: Hey, {{Player.player_name}}![wait=0.25]  Keep an eye out for {{GlobalText.COL_IRIS}}\"Helix Fragments\"[/color].[wait=0.25]  They look like spinning white shells!
		elif Statics.check_item(Item.ItemTypes.HELIX_FRAGMENT) < 30 or not Statics.get_world_flag(Statics.WorldFlags.TALKED_TO_IRIS)
			NPC14: They say that the {{GlobalText.COL_IRIS}}Shrine of Iris[/color] is not located on any map!
		else
			NPC14: Wow, {{Player.player_name}}![wait=0.125]  You're pretty good at finding secrets![wait=0.25]  Maybe you should become a detective!
	
	when \"15\"
		if Statics.get_item_percentage() < 20.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a hint:[wait=0.125] Come back to town after each area to find secret items!
		elif Statics.get_item_percentage() < 40.0
			if Player.instance.who_i_is == Player.Players.SNAILY or Player.instance.who_i_is == Player.Players.UPSIDE
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a little hint:[wait=0.125] A shell can fit where a snail cannot!
			elif Player.instance.who_i_is == Player.Players.SLUGGY or Player.instance.who_i_is == Player.Players.LEECHY
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Here's a li'l hint:[wait=0.125] {{Player.player_species_plural}} may be more fragile than snails,[wait=0.125] but they're also faster!
			elif Player.instance.who_i_is == Player.Players.LEGGY
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Here's a tip:[wait=0.125] It may look too big,[wait=0.125] but your shell can fit in places that ours can!
			else
				NPC15: Hi, {{Player.player_name}}![wait=0.125]  Here's a little tip:[wait=0.125] You don't have to be on the ground to jump!
		elif Statics.get_item_percentage() < 60.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a hint:[wait=0.125] Sometimes, you'll miss a secret if you cling to a wall!
		elif Statics.get_item_percentage() < 80.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me give you a hint:[wait=0.125] You can find the \"high jump\" before any other item!
		elif Statics.get_item_percentage() < 100.0
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me tell you a secret:[wait=0.125] There's a boomerang somewhere in {{GlobalText.COL_TOWN}}Snail Town[/color]!
		else
			NPC15: Hi, {{Player.player_name}}![wait=0.125]  Let me tell you a secret:[wait=0.125] there's a secret somewhere in the main menu!
	
	when \"16\"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			if Player.instance.who_i_is != Player.Players.LEECHY
				NPC16: If you ever get hurt,[wait=0.125] [color=#4bd867]eat some plants[/color]![wait=0.25]  You need to eat well to stay fit and healthy!
			else
				NPC16: If you ever get hurt,[wait=0.125] defeat enemies![wait=0.25]  As a leech,[wait=0.125] you can earn [color=#ff75f6]pink heath orbs[/color] off them!
		elif CutsceneController.instance.actor_above(\"16\", 710)
			NPC16: I want to go for a ride!!!
		else
			# WaveHere SfxHere
			NPC16: [speed=0.6]WHEEEE!![speed=1][wait=0.125]  That was fun, {{Player.player_name}}![wait=0.125]  Let's do it again!!
	
	when \"17\"
		if Statics.get_item_percentage() < 100.0
			NPC17: There's a hidden room under the path into town.[wait=0.25]  I don't know how to get in yet, though...
		else
			NPC17: They call me [color=#ffb23d]upside-down snail[/color],[wait=0.25] but I think everyone else is upside down!
	
	when \"25\"
		if not Statics.check_item(Item.ItemTypes.PEASHOOTER) and not Statics.check_item(Item.ItemTypes.BOOMERANG) and not Statics.check_item(Item.ItemTypes.SECRET_BOOMERANG)
			NPC25: Have you tried hitting {{GlobalText.COL_CTRL}}\"{{SInput.icon_map}}\"[/color] yet?[wait=0.25]  It makes the map big![wait=0.25]  Oh,[wait=0.125] and hit {{GlobalText.COL_CTRL}}\"{{SInput.icon_pause}}\"[/color] for the menu!
		else
			NPC25: Hey {{Player.player_name}},[wait=0.125] I'm hungry![wait=0.25]  Know any good plants around town?
	
do CutsceneController.hide_textbox()
=> END"
scroll_smooth = true
scroll_vertical = 2.0
syntax_highlighter = SubResource("SyntaxHighlighter_mpdoc")

