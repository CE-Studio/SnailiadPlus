; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Snailiad Plus"
config/version="b0.4.0"
run/main_scene="uid://dntc0s7wr1h1g"
config/project_settings_override="user://general_settings.godot"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=60
config/icon="res://Assets/Images/Icon.png"
config/old_version="b0.0.0"

[audio]

volume/master=15
volume/music=15
volume/sound=15

[autoload]

StaticProcess="*res://Scripts/StaticProcess.gd"
cutcontroll="res://Scenes/internals/CutsceneController.tscn"
SInput="*res://Scripts/SInput.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GlobalText="*res://Scripts/GlobalText.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=400
window/size/viewport_height=240
window/size/resizable=false
window/size/sharp_corners=true
window/size/window_width_override=800
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
mouse_cursor/custom_image="uid://btlcuqewcs61t"
window/size/aspect_ratio=0

[editor]

run/main_run_args="debug"

[editor_overrides]

text_editor/theme/highlighting/line_number_color=Color(1, 0, 0, 1)

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdLinter/plugin.cfg")

[game]

ui/minimap=2
ui/keymap=false
ui/in_game_time=false
ui/fps_counter=false
visuals/frame_limit=2
visuals/screen_shake=2
ui/secret_map_tiles=false
visuals/palette_shader=false
visuals/distortion_shader=true
visuals/darkness=3
visuals/texture_pack="__DEFAULT__"
visuals/sound_pack="__DEFAULT__"
visuals/music_pack="__DEFAULT__"
visuals/text_pack="__DEFAULT__"
world/breakables=0
world/particles=5
control/toggle_shoot=false
control/omni_stick_aim=false
control/gravity_swap=0
control/gravity_keep=0
control/controls=[]
control/controller_type=0
ui/bottom_keys=true
visuals/dynamic_camera=true
control/deadzone_move=0.2
control/deadzone_aim=0.2
visuals/opaque_afterimages=true
world/damage_numbers=false

[gui]

theme/custom="uid://dbtbq5hs1dmxo"
theme/custom_font="uid://bo28bqj6d1u8m"

