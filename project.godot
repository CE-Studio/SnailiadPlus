; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Snailiad Plus"
config/version="b0.4.0"
run/main_scene="uid://dntc0s7wr1h1g"
config/features=PackedStringArray("4.4", "Double Precision", "Forward Plus")
run/max_fps=60
config/icon="res://Assets/Images/Icon.png"

[autoload]

StaticProcess="*res://Scripts/StaticProcess.gd"
cutcontroll="res://Scenes/internals/CutsceneController.tscn"
SInput="*res://Scripts/SInput.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=240
window/size/resizable=false
mouse_cursor/custom_image="uid://btlcuqewcs61t"

[editor]

run/main_run_args="debug"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdLinter/plugin.cfg")

[gui]

theme/custom="res://UI/uitheme.tres"
theme/custom_font="res://UI/Snailplanes Extended.ttf"

