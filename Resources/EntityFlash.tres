code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 flash_color : source_color = vec4(0.000000, 0.000000, 0.000000, 1.000000);



void vertex() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;
	float n_out2p3 = n_out2p0.b;
	float n_out2p4 = n_out2p0.a;


// ColorParameter:4
	vec4 n_out4p0 = flash_color;
	float n_out4p1 = n_out4p0.r;
	float n_out4p2 = n_out4p0.g;
	float n_out4p3 = n_out4p0.b;


// ColorOp:10
	vec3 n_out10p0 = max(vec3(n_out2p0.xyz), vec3(n_out4p0.xyz));


// Output:0
	COLOR.rgb = n_out10p0;
	COLOR.a = n_out2p4;


}
"
