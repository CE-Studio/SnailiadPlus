code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_3 : hint_screen_texture;



void fragment() {
// Input:5
	float n_out5p0 = TIME;


// Input:4
	vec2 n_out4p0 = SCREEN_UV;


// VectorDecompose:8
	float n_out8p0 = n_out4p0.x;
	float n_out8p1 = n_out4p0.y;


// FloatConstant:28
	float n_out28p0 = 16.000000;


// FloatOp:12
	float n_out12p0 = n_out8p1 * n_out28p0;


// IntConstant:32
	int n_out32p0 = 15;


// FloatOp:29
	float n_out29p0 = n_out12p0 * float(n_out32p0);


// FloatFunc:30
	float n_out30p0 = floor(n_out29p0);


// FloatOp:31
	float n_out31p0 = n_out30p0 / float(n_out32p0);


// FloatOp:11
	float n_out11p0 = n_out5p0 + n_out31p0;


// FloatFunc:6
	float n_out6p0 = sin(n_out11p0);


// FloatOp:27
	float n_in27p1 = 0.40000;
	float n_out27p0 = n_out6p0 * n_in27p1;


// FloatConstant:20
	float n_out20p0 = 3.000000;


// FloatOp:26
	float n_out26p0 = n_out27p0 * n_out20p0;


// FloatOp:18
	float n_out18p0 = n_out26p0 * n_out20p0;


// FloatFunc:21
	float n_out21p0 = floor(n_out18p0);


// FloatOp:19
	float n_out19p0 = n_out21p0 / n_out20p0;


// FloatOp:25
	float n_in25p1 = 400.00000;
	float n_out25p0 = n_out20p0 / n_in25p1;


// FloatOp:10
	float n_out10p0 = n_out19p0 * n_out25p0;


// FloatOp:9
	float n_out9p0 = n_out10p0 + n_out8p0;


// VectorCompose:7
	vec2 n_out7p0 = vec2(n_out9p0, n_out8p1);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(screen_tex_frg_3, n_out7p0);


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);


}
