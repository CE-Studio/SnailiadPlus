[sub_resource type="GDScript" id="GDScript_opako"]
script/source = "@tool
extends Sprite2D


@export_range(0, 7) var id:int = 0:
	set(val):
		id = val
		frame_coords = Vector2i(tframe, id)
@export_range(0, 3) var tframe:int = 3:
	set(val):
		tframe = val
		frame_coords = Vector2i(tframe, id)
"

