[sub_resource type="GDScript" id="GDScript_45c1g"]
resource_name = "DisplayOptions"
script/source = "extends VBoxContainer


func _ready() -> void:
	$\"ScrollContainer/VBoxContainer/Scale\".remote_set_option(int(Statics.data_general[\"window_scale\"]))
	$\"ScrollContainer/VBoxContainer/Ratio\".remote_set_option(int(Statics.data_general[\"aspect_ratio\"]))
	$\"ScrollContainer/VBoxContainer/Minimap\".remote_set_option(int(Statics.data_general[\"minimap_state\"]))
	$\"ScrollContainer/VBoxContainer/BottomKeys\".remote_set_option(int(Statics.data_general[\"bottom_key_state\"]))
	$\"ScrollContainer/VBoxContainer/InputMap\".toggled_on = bool(Statics.data_general[\"keymap_toggle\"])
	$\"ScrollContainer/VBoxContainer/InGameTime\".toggled_on = bool(Statics.data_general[\"time_toggle\"])
	$\"ScrollContainer/VBoxContainer/Framerate\".toggled_on = bool(Statics.data_general[\"fps_toggle\"])
	$\"ScrollContainer/VBoxContainer/Particles\".remote_set_option(int(Statics.data_general[\"particle_state\"]))
	$\"ScrollContainer/VBoxContainer/Darkness\".remote_set_option(int(Statics.data_general[\"darkness_level\"]))
	$\"ScrollContainer/VBoxContainer/PaletteShader\".toggled_on = bool(Statics.data_general[\"palette_shader_toggle\"])
	$\"ScrollContainer/VBoxContainer/DistortShader\".toggled_on = bool(Statics.data_general[\"distort_shader_toggle\"])


func on_scale_cycled(value) -> void:
	set_window_size(value, Statics.ASPECT_RATIOS[Statics.data_general[\"aspect_ratio\"]])
	Statics.data_general[\"window_scale\"] = value


func on_ratio_cycled(value) -> void:
	var this_ratio = Statics.ASPECT_RATIOS[value]
	set_window_size(Statics.data_general[\"window_scale\"], this_ratio)
	Statics.data_general[\"aspect_ratio\"] = value


func on_minimap_cycled(value) -> void:
	Statics.data_general[\"minimap_state\"] = value


func on_bottom_keys_cycled(value) -> void:
	Statics.data_general[\"bottom_key_state\"] = value


func on_input_map_toggled(value) -> void:
	Statics.data_general[\"keymap_toggle\"] = value


func on_igt_toggled(value) -> void:
	Statics.data_general[\"time_toggle\"] = value


func on_fps_toggled(value) -> void:
	Statics.data_general[\"fps_toggle\"] = value


func on_particles_cycled(value) -> void:
	Statics.data_general[\"particle_state\"] = value


func on_darkness_cycled(value) -> void:
	Statics.data_general[\"darkness_level\"] = value


func on_pshader_toggled(value) -> void:
	Statics.data_general[\"palette_shader_toggle\"] = value


func on_dshader_toggled(value) -> void:
	Statics.data_general[\"distort_shader_toggle\"] = value


func set_window_size(_scale:int, _ratio:Vector2i) -> void:
	var new_size:Vector2i = _ratio * (_scale + 1)
	var window = get_window()
	#ProjectSettings.set_setting(\"display/window/size/viewport_width\", new_size.x)
	#ProjectSettings.set_setting(\"display/window/size/viewport_height\", new_size.y)
	#DisplayServer.window_set_size(new_size)
	var old_size = window.size
	var old_position = window.position
	window.size = new_size
	window.content_scale_factor = _scale + 1
	var difference = new_size - old_size
	window.position = old_position - Vector2i(difference * 0.5)
"

